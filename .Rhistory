library(ggpicrust2)
library(readr)
library(tibble)
library(dplyr)
library(ggplot2)
# Paths (project-relative)
source("config.R")
metadata_path <- file.path(home, "data", "metadata.csv")
ko_path <- file.path(
home, "results", "picrust2_output_26_11_2025", "picrust2_out_pipeline_run",
"KO_metagenome_out", "pred_metagenome_unstrat.tsv.gz"
)
output_dir <- file.path("results", "functional_analysis")
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)
# Load metadata and keep NGI IDs as rownames
metadata <- read.csv(metadata_path, sep = ";", fileEncoding = "latin1", check.names = FALSE)
rownames(metadata) <- metadata$NGI_ID
# Load KEGG KO abundances (PICRUSt2)
ko_abundance <- read_tsv(ko_path) %>%
column_to_rownames("function")
# Manual drop of low-quality samples (documented)
drop_samples <- c("P34104_331", "P34104_333")
present_drop <- intersect(drop_samples, colnames(ko_abundance))
if (length(present_drop) > 0) {
ko_abundance <- ko_abundance[, !(colnames(ko_abundance) %in% present_drop), drop = FALSE]
}
# Sync samples between metadata and KO table
common_samples <- intersect(colnames(ko_abundance), rownames(metadata))
if (length(common_samples) == 0) stop("No overlapping samples between metadata and KO abundance.")
ko_abundance <- ko_abundance[, common_samples, drop = FALSE]
metadata <- metadata[common_samples, , drop = FALSE]
# Remove any samples without Zoo info (should already be absent in KO table)
has_zoo <- !is.na(metadata$Zoo)
if (any(!has_zoo)) {
ko_abundance <- ko_abundance[, has_zoo, drop = FALSE]
metadata <- metadata[has_zoo, , drop = FALSE]
}
# Run ANCOM-BC DAA via ggpicrust2 (KEGG level)
full_workflow_results <- ggpicrust2(
ko_abundance = ko_abundance,
metadata = metadata,
group_col = "Zoo",
method = "ANCOMBC",
pathway_level = "KEGG"
)
full_workflow_results <- ggpicrust2(
ko_abundance = ko_abundance,
metadata = metadata,
group = "Zoo",
method = "ANCOMBC",
pathway_level = "KEGG"
)
full_workflow_results <- ggpicrust2(
ko = ko_abundance,
metadata = metadata,
group = "Zoo",
method = "ANCOMBC",
level = "KEGG"
)
full_workflow_results <- ggpicrust2(
ko = ko_abundance,
metadata = metadata,
group = "Zoo",
daa_method = "ANCOMBC",
level = "KEGG"
)
full_workflow_results <- ggpicrust2(data = ko_abundance,
metadata = metadata,
group = "Zoo",
pathway = "KO",
daa_method = "LinDA",
ko_to_kegg = TRUE,
order = "pathway_class",
p_values_bar = TRUE,
)
View(daa_res)
View(daa_res_sig)
# Första kolumnen brukar heta "pathway" – gör den till rownames:
pathway_abundance <- metacyc_abundance %>%
tibble::column_to_rownames("pathway")
