library(tibble)
path_tbl <- pathway_abundance_filt %>%
rownames_to_column("pathway")
top20 <- path_tbl %>%
mutate(total = rowSums(across(-pathway))) %>%
arrange(desc(total)) %>%
slice_head(n = 20)
pathway_abundance_top20 <- top20 %>%
select(-total) %>%
column_to_rownames("pathway")
pathway_heatmap(
abundance = pathway_abundance_filt,
metadata = metadata,
group = "Zoo",
topN = 20
) +
